FROM scratch AS ctx

COPY ./shared/ /shared

FROM docker.io/archlinux/archlinux:latest AS base

FROM base AS system

RUN mkdir -p /usr/lib/sysimage && \
    mv /var/lib/pacman /usr/lib/sysimage/pacman && \
    ln -s /usr/lib/sysimage/pacman /var/lib/pacman && \
    mkdir -p /usr/lib/tmpfiles.d && \
    printf 'L+ /var/lib/pacman - - - - /usr/lib/sysimage/pacman\n' \
        > /usr/lib/tmpfiles.d/ilsm-pacman.conf

#PRE-SCRIPTS-HERE

RUN pacman -Syu --noconfirm

RUN pacman -Sy --noconfirm [PACKAGES] && pacman -S --clean --noconfirm

RUN --mount=type=tmpfs,dst=/tmp --mount=type=tmpfs,dst=/root \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    /ctx/shared/initramfs.sh

RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    sed -i 's|^HOME=.*|HOME=/var/home|' "/etc/default/useradd" && \
    /ctx/shared/bootc-rootfs.sh

#ROOTFS-HERE

#POST-SCRIPTS-HERE

RUN ln -s /usr/lib/sysimage/pacman /var/lib/pacman

LABEL containers.bootc 1

RUN bootc container lint
